const { obtenerCitasManana, marcarRecordatorioEnviado } = require('./db');
const WHATSAPP_TOKEN = process.env.WHATSAPP_TOKEN;
const PHONE_NUMBER_ID = process.env.PHONE_NUMBER_ID;
// Nombre exacto de tu plantilla aprobada en Meta
const NOMBRE_PLANTILLA = 'recordatorio_cita';

// IMPORTANTE sobre zonas horarias:
// La columna citas.fecha_hora es un TIMESTAMP (sin zona horaria) y se guarda
// con el valor literal que Claude decide, ej. "2026-06-25 10:00:00" para una
// cita a las 10am hora CDMX (NO son 10am UTC).
// El driver "pg" convierte esos TIMESTAMP a objetos Date agregándoles una
// "Z" (o sea, los etiqueta como si fueran UTC), sin hacer ninguna conversión
// real de zona horaria. Entonces el Date que llega aquí ya tiene, en su
// valor UTC interno, los mismos dígitos que se guardaron en la base de
// datos (10:00, no 16:00 ni 04:00).
// Por eso, para mostrar la hora tal cual se guardó, hay que formatear con
// timeZone: 'UTC' (NO 'America/Mexico_City'): usar 'America/Mexico_City'
// aquí le restaría 6 horas de más y mostraría una hora incorrecta al
// paciente. Se comprobó este comportamiento directamente con pg-types.
function formatearFecha(fechaISO) {
  return new Date(fechaISO).toLocaleDateString('es-MX', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });
}
// Formatea la hora en formato 12 hrs
function formatearHora(fechaISO) {
  return new Date(fechaISO).toLocaleTimeString('es-MX', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  });
}
// Envía el recordatorio usando la plantilla de Meta
async function enviarRecordatorio(cita) {
  // Todo el cuerpo va dentro de try/catch: antes, si fetch fallaba (ej. error
  // de red) o res.json() lanzaba una excepción (respuesta no-JSON), el error
  // no quedaba controlado aquí y se propagaba hasta el for de
  // procesarRecordatorios, cortando en seco el envío de recordatorios a
  // TODOS los demás pacientes del día. Ahora un fallo con un paciente no
  // afecta a los demás.
  try {
    const fecha = formatearFecha(cita.fecha_hora);
    const hora = formatearHora(cita.fecha_hora);
    const body = {
      messaging_product: 'whatsapp',
      to: cita.telefono,
      type: 'template',
      template: {
        name: NOMBRE_PLANTILLA,
        language: { code: 'es_MX' },
        components: [
          {
            type: 'body',
            parameters: [
              { type: 'text', text: cita.nombre },
              { type: 'text', text: cita.motivo },
              { type: 'text', text: fecha },
              { type: 'text', text: hora },
            ],
          },
        ],
      },
    };
    const res = await fetch(
      `https://graph.facebook.com/v21.0/${PHONE_NUMBER_ID}/messages`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${WHATSAPP_TOKEN}`,
        },
        body: JSON.stringify(body),
      }
    );
    const data = await res.json();
    if (data.error) {
      console.error(`Error enviando recordatorio a ${cita.telefono}:`, data.error);
      return false;
    }
    console.log(`Recordatorio enviado a ${cita.nombre} (${cita.telefono})`);
    return true;
  } catch (err) {
    console.error(`Excepción enviando recordatorio a ${cita.telefono}:`, err);
    return false;
  }
}
// Función principal: revisa citas de mañana y manda recordatorios
async function procesarRecordatorios() {
  console.log('Procesando recordatorios...');
  try {
    const citas = await obtenerCitasManana();
    console.log(`Citas encontradas para mañana: ${citas.length}`);
    for (const cita of citas) {
      const enviado = await enviarRecordatorio(cita);
      if (enviado) {
        await marcarRecordatorioEnviado(cita.id);
      }
    }
    console.log('Recordatorios procesados.');
  } catch (err) {
    console.error('Error procesando recordatorios:', err);
  }
}
module.exports = { procesarRecordatorios };
